DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=mis_solution
ADMIN_SESSION_SECRET=change_this_to_a_random_string_at_least_32_chars

# NextAuth (customer authentication)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_to_a_random_secret_string

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudflare Turnstile (get from https://dash.cloudflare.com/turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# --- SMTP / Email (cPanel mailbox on DhakaWebHost) ---
# Get exact host/port from cPanel > Email Accounts > Manage noreply@ > Connect Devices
SMTP_HOST=mail.missolution.com.bd
SMTP_PORT=465
SMTP_USER=noreply@missolution.com.bd
SMTP_PASSWORD=your_noreply_mailbox_password
SMTP_FROM="MIS Solution <noreply@missolution.com.bd>"

# Public site URL used in email links
NEXT_PUBLIC_SITE_URL=https://missolution.com.bd

# Admin alert recipients (defaults derived from MAIL_DOMAIN if omitted)
MAIL_DOMAIN=missolution.com.bd
ALERT_EMAIL_APPLICATIONS=hr@missolution.com.bd
ALERT_EMAIL_QUOTES=sales@missolution.com.bd
ALERT_EMAIL_ORDERS=sales@missolution.com.bd
ALERT_EMAIL_FALLBACK=info@missolution.com.bd
